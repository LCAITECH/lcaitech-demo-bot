# Copiar a .env SOLO si no se pasa el token por variable de entorno. Después: chmod 600 .env
# .env está en .gitignore y .dockerignore. NUNCA subirlo al repo.
TELEGRAM_BOT_TOKEN=
# Opcionales
COINGECKO_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gemini-flash-lite-latest
# En MEXC, 1000 trades cubren pocos minutos; 20k USD es un umbral realista para BTCUSDT
WHALE_MIN_USD=20000
# /ask: preguntas por usuario por día y segundos mínimos entre preguntas
ASK_DAILY_LIMIT=20
ASK_COOLDOWN_SEC=5
PORTFOLIO_URL=https://portfolio.lcaitech.com
# Endpoint propio de unlocks (opcional, formato {"items":[...], "updated_at": ...}). Vacío = respuesta explicativa
ATH_API_URL=
# /comunidad (simulación con usuarios ficticios): cooldown por usuario, demos cortas, tope global y diario; SIM_SPEED<1 = más rápido
SIM_COOLDOWN_SEC=90
SIM_DEMO_COOLDOWN_SEC=20
SIM_MAX_RUNNING=8
SIM_DAILY_LIMIT=15
SIM_SPEED=1
# Guardia para grupos reales: 1 = bienvenida + borra scams claros (seed phrase, airdrop falso con link, "duplicá", falso soporte).
# Requiere que el bot sea admin del grupo con permiso "Eliminar mensajes". Nunca borra mensajes de admins. Por defecto apagado.
GROUP_GUARD=0
